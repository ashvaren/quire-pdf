{
  "name": "Quire PDF by Ashvaren",
  "short_name": "Quire",
  "description": "Ashvaren Advisory PDF editor. Works offline; your files never leave this computer.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f3f0ea",
  "theme_color": "#1c2b38",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/pdf": [
          ".pdf"
        ]
      }
    }
  ]
}